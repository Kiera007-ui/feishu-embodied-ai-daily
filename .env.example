# Required
OPENAI_API_KEY=sk-...
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/...

# Recommended security
CRON_SECRET=replace-with-a-long-random-string
MANUAL_SECRET=replace-with-another-long-random-string

# Optional: only if you enable "签名校验" for the Feishu custom bot
FEISHU_BOT_SECRET=

# Optional
OPENAI_MODEL=gpt-5.6-terra
