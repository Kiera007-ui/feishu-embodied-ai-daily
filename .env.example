# Required for both manual and automatic push
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/...

# Required for automatic daily generation
OPENAI_API_KEY=sk-...

# Required: Vercel Cron automatically sends this as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Recommended: allows authenticated dry-run/manual invocation of /api/push
MANUAL_SECRET=replace-with-another-long-random-string

# Optional
OPENAI_MODEL=gpt-5.6-sol
AUTO_PUSH_DISABLED=0
