# Existing Feishu custom-bot webhook
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/...

# Required for Vercel Cron authentication
CRON_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Optional manual dry-run authentication
MANUAL_SECRET=replace-with-another-long-random-string

# Optional: AI Gateway model overrides
AI_GATEWAY_MODEL=openai/gpt-5.6-sol
AI_GATEWAY_VERIFY_MODEL=openai/gpt-5.6-terra

# Optional emergency switch
AUTO_PUSH_DISABLED=0

# No OPENAI_API_KEY is required when Vercel OIDC federation is enabled.
# As an alternative, AI_GATEWAY_API_KEY can be configured manually.
